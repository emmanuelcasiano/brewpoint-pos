# Copy this file to .env and fill it in. Never commit .env.
# The values below are for local development.

APP_ENV=local

# Server (apps/server)
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Database: Neon, PostgreSQL 18. Each branch has two connection strings.
# These contain passwords, so they live only in .env.
#
#   MIGRATION_...  the owner login (neondb_owner), DIRECT connection: in the Neon console > Connect,
#                  turn connection pooling off (the host has no -pooler).
#   plain          the app login (brewpoint_app), POOLED connection: printed by pnpm db:roles.
#   PLATFORM_...   the staff console login (brewpoint_platform), POOLED: also printed by pnpm db:roles.

# Development branch
MIGRATION_DATABASE_URL=
DATABASE_URL=
PLATFORM_DATABASE_URL=

# Test branch: wiped and rebuilt by every database test run. Never point these at the development branch.
# The tests log in as brewpoint_platform with TEST_DATABASE_URL's password, so there is no platform test URL.
MIGRATION_TEST_DATABASE_URL=
TEST_DATABASE_URL=

# Sign-in (Module 03)
# Encrypts staff two-step secrets. 32 random bytes in base64; make one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
# Where links in sign-in emails point.
BACKOFFICE_URL=http://127.0.0.1:5173
# Until device pairing (Module 06), the demo POS proves itself with this key. Used only when
# APP_ENV=local. Any random text of 16 characters or more; the POS reads the same value.
DEMO_DEVICE_KEY=
# Optional: which seeded register the POS is. Leave empty for Kape Davao's T1.
DEMO_DEVICE_ID=

# Staging and production: hosting is not chosen yet (see the Module 01 brief).
# Set these on the host, never in a file in the repository:
# APP_ENV=staging or production
# SERVER_HOST=0.0.0.0
# SERVER_PORT=<the host's port>
# DATABASE_URL=<that environment's database, as brewpoint_app>
# PLATFORM_DATABASE_URL=<that environment's database, as brewpoint_platform>
# TOTP_ENCRYPTION_KEY=<its own key, never the local one>
# BACKOFFICE_URL=<the back-office address>
