# Copy this file to .env and fill it in. Never commit .env.
# The values below are for local development.

APP_ENV=local

# Server (apps/server)
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Database: your Neon connection string (PostgreSQL 18).
# Neon console > your project > Connect. It contains a password, so it lives only in .env.
DATABASE_URL=

# Staging and production: hosting is not chosen yet (see the Module 01 brief).
# Set these on the host, never in a file in the repository:
# APP_ENV=staging or production
# SERVER_HOST=0.0.0.0
# SERVER_PORT=<the host's port>
# DATABASE_URL=<that environment's database>
