{
  "name": "brewpoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint tests playwright.config.ts eslint.config.js && prettier --check .",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "turbo run test",
    "test:e2e": "turbo run build && playwright test",
    "format": "prettier --write .",
    "db:check": "pnpm --filter @brewpoint/server db:check",
    "db:roles": "pnpm --filter @brewpoint/server db:roles",
    "db:migrate": "pnpm --filter @brewpoint/server db:migrate",
    "db:migrate:down": "pnpm --filter @brewpoint/server db:migrate:down",
    "db:seed": "pnpm --filter @brewpoint/server db:seed",
    "db:types": "pnpm --filter @brewpoint/server db:types",
    "staff:create": "pnpm --filter @brewpoint/server staff:create"
  },
  "devDependencies": {
    "@brewpoint/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "catalog:",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "catalog:"
  }
}
